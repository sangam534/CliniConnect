# ==============================================================================
# HELP INDIA - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port to listen on (Default: 5000)
PORT=5000

# CORS Allowed Origin (Default: * allows frontend deployed anywhere e.g. Vercel, Netlify, GitHub Pages, or localhost)
CORS_ORIGIN=*

# Primary AI Provider: "openai" | "gemini" | "custom"
AI_PROVIDER=openai

# OpenAI / NVIDIA NIM API Configuration
# For NVIDIA NIM:
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-your_nvidia_api_key_here
OPENAI_MODEL=openai/gpt-oss-20b

# For Official OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional alternative: https://aistudio.google.com/)
GEMINI_API_KEY=

# Custom Online AI App / Webhook Endpoint (Optional: e.g. Dify, Flowise, n8n, FastGPT)
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_API_KEY=
