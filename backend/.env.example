# ==============================================================================
# HELP INDIA - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port to listen on (Default: 5000)
PORT=5000

# CORS Allowed Origin (Default: * allows frontend deployed anywhere e.g. Vercel, Netlify, GitHub Pages, or localhost)
CORS_ORIGIN=*

# Primary AI Provider: "gemini" | "openai" | "custom"
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional fallback: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Custom Online AI App / Webhook Endpoint (Optional: e.g. Dify, Flowise, n8n, FastGPT)
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_API_KEY=
